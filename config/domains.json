{
  "_doc": "Domain -> report catalogue. Collectors read this; nothing else hardcodes series IDs. Report types: series (official API data, new when the reference period advances), decision (central-bank meeting, new when a scheduled meeting date has passed), snapshot (daily market levels, new only on a material move), web (no free API; flagged due by calendar rule, figures fetched by the analyst). Metric keys are '<part>.<transform>'.",
  "domains": [
    {
      "id": "inflation",
      "name": "Inflation",
      "lens": "config/lenses/inflation.md",
      "reports": [
        {
          "id": "cpi",
          "name": "CPI",
          "type": "series",
          "freq": "monthly",
          "tier": 1,
          "source": "fred",
          "parts": {
            "headline": {
              "id": "CPIAUCSL",
              "yoy_id": "CPIAUCNS",
              "transforms": [
                "chg_pct",
                "yoy_pct"
              ]
            },
            "core": {
              "id": "CPILFESL",
              "yoy_id": "CPILFENS",
              "transforms": [
                "chg_pct",
                "yoy_pct"
              ]
            }
          },
          "release_url": "https://www.bls.gov/news.release/cpi.htm",
          "calendar_match": "Consumer Price Index",
          "_note": "FRED mirrors of BLS CUSR0000SA0/CUUR0000SA0 and CUSR0000SA0L1E/CUUR0000SA0L1E. FRED is keyless with no daily cap; the keyless BLS API stops at 25 requests/day."
        },
        {
          "id": "ppi",
          "name": "PPI",
          "type": "series",
          "freq": "monthly",
          "tier": 2,
          "source": "fred",
          "_note": "Final Demand: PPIFIS (=BLS WPSFD4, SA) and PPIFID (=WPUFD4, NSA); core PPIFES (=WPSFD49104, SA; y/y from SA can differ from the NSA headline by 0.1pp). The Hyperagent skill used WPSFD49207 (Finished Goods), which produced the wrong headline three months running.",
          "parts": {
            "headline": {
              "id": "PPIFIS",
              "yoy_id": "PPIFID",
              "transforms": [
                "chg_pct",
                "yoy_pct"
              ]
            },
            "core": {
              "id": "PPIFES",
              "transforms": [
                "chg_pct",
                "yoy_pct"
              ]
            }
          },
          "release_url": "https://www.bls.gov/news.release/ppi.htm",
          "calendar_match": "Producer Price Index"
        },
        {
          "id": "pce",
          "name": "PCE price index",
          "type": "series",
          "freq": "monthly",
          "tier": 1,
          "source": "fred",
          "parts": {
            "headline": {
              "id": "PCEPI",
              "transforms": [
                "chg_pct",
                "yoy_pct"
              ]
            },
            "core": {
              "id": "PCEPILFE",
              "transforms": [
                "chg_pct",
                "yoy_pct"
              ]
            }
          },
          "release_url": "https://www.bea.gov/data/income-saving/personal-income",
          "calendar_match": "Personal Income and Outlays"
        }
      ]
    },
